APP_NAME=AI 多人旅行规划助手
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_assistant
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_USE_FAKE=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120

AMAP_BASE_URL=https://restapi.amap.com
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=10
AMAP_MIN_INTERVAL_SECONDS=1.1
AMAP_RATE_LIMIT_RETRIES=3

# 和风天气控制台为项目分配的专属 API Host，例如 abcxyz.qweatherapi.com
QWEATHER_API_HOST=
QWEATHER_AUTH_TYPE=api_key
QWEATHER_API_KEY=
QWEATHER_JWT_TOKEN=
QWEATHER_TIMEOUT_SECONDS=10

